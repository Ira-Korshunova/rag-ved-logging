# Шаблон .env для сервера.
# РЕАЛЬНЫЙ файл создаётся на сервере: /opt/rag-ved/deploy/.env (права 600).
# Ключ вставляет Ирина руками — ключи никогда не пишутся в чат и не коммитятся.

# --- Эмбеддинги: ЛОКАЛЬНО (BGE-M3, без ключей и квот) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# кеш скачанной модели (~2 ГБ) — в томе, чтобы переживал пересоздание контейнера
HF_HOME=/app/state/hf-cache

# (Опция: облачные эмбеддинги DashScope вместо локальных —
#  раскомментировать эти три строки и закомментировать две выше:
# EMBEDDING_PROVIDER=api
# OPENAI_API_KEY=ВСТАВЬ_КЛЮЧ_DASHSCOPE
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1)

# --- LLM (генерация ответов): DeepSeek ---
LLM_API_KEY=ВСТАВЬ_КЛЮЧ_DEEPSEEK
LLM_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
TOP_K=7

# --- Телеграм-бот (канал запросов, как в уроке PEcf09) ---
# Токен нового бота из @BotFather (/newbot). Кладётся в отдельные поля —
# Work Bot и его токен не трогаем.
TELEGRAM_BOT_TOKEN=ВСТАВЬ_ТОКЕН_НОВОГО_БОТА

# --- Админ-команда /ingest в боте (пополнение базы знаний) ---
# Через запятую — Telegram user_id, которым разрешено пополнять базу ботом.
# Узнать свой user_id: у @userinfobot. Если оставить пустым — /ingest
# допускает любой аккаунт (режим разработки); на сервере рекомендуется вписать.
ADMIN_USER_IDS=ВСТАВЬ_СВОЙ_TG_USER_ID

# --- Логирование (конвейер урока PEcf09) ---
# Срок хранения логов, дней
LOG_RETENTION_DAYS=90
# Пароль страницы статистики /stats?key=... (придумать свой)
STATS_PASSWORD=ПРИДУМАЙ_ПАРОЛЬ

# --- Пути: все хранилища в одном Docker-томе /app/state ---
CHROMA_PATH=/app/state/chroma_db
CACHE_DB_PATH=/app/state/api_rag_cache.db
LOG_DB_PATH=/app/state/request_logs.db