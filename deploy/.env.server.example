# Шаблон .env для сервера.
# РЕАЛЬНЫЙ файл создаётся на сервере: /opt/rag-ved/deploy/.env (права 600).
# Ключ вставляет Ирина руками — ключи никогда не пишутся в чат и не коммитятся.

# --- DashScope (Qwen): ключ работает и для генерации, и для эмбеддингов ---
OPENAI_API_KEY=ВСТАВЬ_КЛЮЧ_DASHSCOPE
OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-max
EMBEDDING_MODEL=text-embedding-v3
TOP_K=7

# --- Логирование (конвейер урока PEcf09) ---
# Срок хранения логов, дней
LOG_RETENTION_DAYS=90
# Пароль страницы статистики /stats?key=... (придумать свой)
STATS_PASSWORD=ПРИДУМАЙ_ПАРОЛЬ

# --- Пути: все хранилища в одном Docker-томе /app/state ---
CHROMA_PATH=/app/state/chroma_db
CACHE_DB_PATH=/app/state/api_rag_cache.db
LOG_DB_PATH=/app/state/request_logs.db